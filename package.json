{
  "name": "nutrifarmer-front-program-board",
  "version": "1.4.3",
  "private": true,
  "description": "Nutri-Farmer_Front_Program_Board — 단위 프로그램 실행 보드",
  "scripts": {
    "dev": "node scripts/next-dev-safe.mjs",
    "dev:fresh": "node scripts/next-dev-safe.mjs --fresh",
    "dev:fast": "next dev -p 3000",
