{
  "github": {
    "silent": true
  },
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    { "source": "/", "destination": "/biz-board/index.html" },
    { "source": "/biz-board", "destination": "/biz-board/index.html" }
  ],
  "headers": [
    {
      "source": "/biz-board/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
