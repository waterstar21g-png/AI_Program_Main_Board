{
  "name": "ai-program-main-board",
  "version": "3.4.2",
  "private": true,
  "description": "AI_Program_Main_Board — P1_Category_Url_Extract / P2_Product_Capture_App / P3_Python_Item_Collector",
  "scripts": {
    "dev": "node scripts/next-dev-safe.mjs",
    "dev:fresh": "node scripts/next-dev-safe.mjs --fresh",
    "dev:webpack": "NEXT_USE_WEBPACK=1 node scripts/next-dev-safe.mjs",
    "dev:fast": "next dev --turbo -p 3000 -H 0.0.0.0",
    "local:build": "npm run build",
    "local:start": "next start -p 3000 -H 0.0.0.0",
    "clean": "node scripts/clean-next.mjs --kill-port --all",
    "prebuild": "node scripts/clean-next.mjs --build",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "p1": "node scripts/run-p1.mjs",
    "p2": "node scripts/run-p2.mjs",
    "p3": "node scripts/run-p3.mjs",
    "verify:p1": "node scripts/run-p1.mjs",
    "verify:p2": "node scripts/run-p2.mjs",
    "verify:p3": "node scripts/run-p3.mjs",
    "verify:all": "node scripts/verify-projects.mjs all",
    "test:projects": "node scripts/smoke-projects.mjs",
    "test:projects:local": "node scripts/smoke-projects.mjs --local",
    "vercel:link": "vercel link --yes --scope nutrifarmer-front --project AI_Program_Main_Board",
    "vercel:deploy": "vercel --prod --yes --scope nutrifarmer-front --name AI_Program_Main_Board"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "next": "^15.3.3",
    "playwright": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
